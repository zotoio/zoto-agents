# Dependencies
node_modules/

# Build output
dist/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.pytest_cache/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment and secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/

# Logs and temp
*.log
tmp/
temp/

# Eval workspace outputs (generated during skill evaluation runs)
plugins/*/skills/*/evals/workspace/

# Eval run artefacts (regenerable via pnpm run eval:full / eval:gc)
evals/_runs/
!evals/_runs/.gitkeep

# Eval analyser cache. The analyser payloads under cache/analyser/ are
# deliberately tracked: CI runs `eval:update:check -- --no-analyser` and
# `--apply --no-analyser` reuses them instead of paying for an LLM call.
.zoto/eval-system/cache/
!.zoto/eval-system/cache/.gitkeep
!.zoto/eval-system/cache/analyser/

# Cursor local install artifacts
.cursor/plugins/

# X-Fidelity analysis results
.xfiResults/

# Python virtual environment (skills-ref)
.venv/

.ruff_cache/
