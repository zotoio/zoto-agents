{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zotoio.github.io/zoto-agents/schemas/zoto-spec-system/loop-status.schema.json",
  "title": "Zoto Spec System Loop Status",
  "description": "Spec-root `loop-status.yml` written by a loop executor after every iteration. Phased specs do not have this file. The aggregator does not read or rewrite it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "state", "iteration", "limits", "usage", "checks", "iterations"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "spec_id": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["pending", "working", "checking", "completed", "stopped", "failed"] },
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [null, "all_checks_passed", "max_loops", "max_duration", "max_cost", "max_tokens", "stalled", "cancelled", "error"]
    },
    "iteration": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_loops", "max_duration_minutes"],
      "properties": {
        "max_loops": { "type": "integer", "minimum": 1 },
        "max_duration_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "swarm_size": { "type": "integer", "minimum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "cost_usd", "elapsed_minutes"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "elapsed_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{2}$" },
          "state": { "type": "string", "enum": ["pending", "passed", "failed", "error"] },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string" }
        }
      }
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "outstanding", "passed", "tokens", "cost_usd"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" },
          "outstanding": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{2}$" }, "description": "Checks failing when the iteration started." },
          "passed": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{2}$" }, "description": "Checks passing after the iteration's check run." },
          "tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "agents": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
