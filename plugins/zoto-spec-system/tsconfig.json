{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "hooks/**/*.ts",
    "src/**/*.ts"
  ]
}
