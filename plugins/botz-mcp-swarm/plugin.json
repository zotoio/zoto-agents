{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "botz-mcp-swarm",
  "version": "0.9.0",
  "description": "Capture, run, and diagnose MCP test suites with the botz MCP Swarm CLI.",
  "author": {
    "name": "zotoio",
    "email": "plugins@zotoio.com"
  },
  "homepage": "https://github.com/zotoio/zoto-agents/tree/main/plugins/botz-mcp-swarm",
  "repository": "https://github.com/zotoio/zoto-agents",
  "license": "MIT",
  "keywords": [
    "mcp",
    "testing",
    "load-testing"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "MCP Swarm",
        "shortDescription": "Test and load-test MCP servers",
        "longDescription": "Skills for the botz MCP Swarm CLI: capture suites from live MCP servers, run repeatable assertions and load tests, diagnose failures, and upgrade saved suites. The skills install the botz host and its mcp-swarm extension on first use.",
        "developerName": "zotoio",
        "category": "Developer Tools",
        "websiteURL": "https://github.com/zotoio/zoto-agents/tree/main/plugins/botz-mcp-swarm",
        "composerIcon": "./assets/logo.svg",
        "logo": "./assets/logo.svg"
      }
    }
  }
}
